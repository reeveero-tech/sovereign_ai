# إثبات عطل البوابة وإصلاحه (التشغيل المحلي الفعلي — 2026-10-17)

$ set -o pipefail
$ git show 1a9141f | grep -q "# DELETION-JUSTIFIED"
grep exit=141 ; git-show exit=141          # ← grep -q يقتل git show بـSIGPIPE
$ git show 1a9141f | grep "# DELETION-JUSTIFIED" >/dev/null
no-q grep exit=0 ; git-show exit=0          # ← بلا -q: كلاهما يخرج 0

# نموذج البوابة القديم (grep -q + pipefail) على نفس الالتزام: GATE-FAIL (رفض زائف)
# نموذج البوابة بعد الإصلاح على نفس الالتزام: GATE-PASS
# العلامة موجودة في فرق 1a9141f أربع مرات — الرفض كان زائفًا قطعيًا.
