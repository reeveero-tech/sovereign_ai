# .env.example — نموذج إعدادات التشغيل (انسخه إلى .env وعدّل القيم)
#
# القاعدة (R-704/R-719): كل طبقة خارجية معطلة افتراضيًا وتُفعّل صراحة هنا.
# ملف .env مستثنى من git (حماية حراسة العناوين الخاصة — لا عنوان خاص في
# الملفات المتتبعة أبدًا). الاختبارات معزولة عنه بالبناء (conftest — R-720).
# ملاحظة مهمة: المتغيرات البيئية تعلو على هذا الملف دائمًا.

# ---------- عقل Ollama (R-704/R-720) ----------
# خادم المالك على شبكته المحلية (عنوانه بصيغة مقنعة هنا — الصيغة الحرفية
# للمالك فقط، انظر تقرير الإحياء R-816): منفذ 11434 المعياري.
# النماذج المحملة عليه: phi3:latest / gemma2:latest / deepseek-coder:6.7b /
# qwen2.5:latest / llama3.2:latest — القائمة تُكتشف حيًا (GET /brain/models
# بمفتاح المالك). ملاحظة إنتاج: السحابة لا تبلغ عناوين الشبكات المحلية،
# والنشر على fly.io يستخدم خادم Ollama داخليًا على شبكة fly الخاصة؛ هذه
# القيم للاستخدام المحلي على شبكة المالك.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://192.168.0.x:11434
# النموذج صريح لا افتراضي — يجب أن يكون مثبتًا على الخادم (قائمة النماذج:
# curl <BASE_URL>/api/tags). مناسب للعربية من قائمة المالك: qwen2.5:latest
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_TIMEOUT_SECONDS=150

# ---------- قرص Supabase وذاكرته (R-719) ----------
# معطل افتراضيًا — يُفعّل بتوفر الرابط وسرّ الخدمة معًا.
# على الإنتاج: عبر أسرار المستودع ← خطوة المزامنة في سير النشر ترفعها إلى Fly.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT_SECONDS=10
