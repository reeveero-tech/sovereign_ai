#!/bin/sh
# hook محلي pre-commit — حارسا D-040 المقوى (R-748) والعناوين الخاصة
# (قرار المالك 2026-10-20 + القاعدة الحاكمة 2026-10-24).
# يفحص محتوى الفهرس (ما سيُلتزم فعلًا) قبل إنشاء الالتزام، بالنواة نفسها التي
# تستخدمها بوابة CI (التنفيذ الموحد tools/gate_docs_sync.py). التفعيل مرة
# واحدة لكل استنساخ:
#     git config core.hooksPath .githooks
# حدّ معلن: hook محلي يمكن تجاوزه (--no-verify)؛ البوابة الصلبة تبقى CI.
ROOT="$(git rev-parse --show-toplevel)" || exit 2
PY="${PYTHON:-python3}"
command -v "$PY" >/dev/null 2>&1 || PY=python
# القاعدة الحاكمة: كود في الفهرس بلا الثلاثة الحرفية (الحالة + السجل +
# الخارطة) يُرفض قبل إنشاء الالتزام
"$PY" "$ROOT/tools/gate_docs_sync.py" --staged || exit 1
# حارس العناوين الخاصة (قرار المالك د.٣)
exec "$PY" "$ROOT/tools/private_ip_guard.py" --staged
